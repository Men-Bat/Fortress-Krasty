# Identidad y servicio
NODE_ENV=production
PORT=3000
NODE_TYPE=local
NODE_ROLE=primary
# Generar con: openssl rand -hex 32
SECRET_KEY=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_64_HEX
# Debe ser igual solamente entre los nodos local y cloud. Generar con: openssl rand -hex 32
SYNC_TOKEN=REEMPLAZAR_CON_OTRO_SECRETO_ALEATORIO_DE_64_HEX

# Seguridad de sesión
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
TRUST_PROXY=1

# Nodo secundario. Debe usar HTTPS en producción.
CLOUD_NODE_URL=https://krasty-secundario.ejemplo.com
# URL de un almacenamiento remoto compatible con WebDAV o SFTP. No incluir credenciales en esta plantilla.
BACKUP_MANIFEST_URL=https://archivos.ejemplo.com/krasty-vault

# Directorio local de archivos de usuarios y snapshots; debe existir y tener permisos restringidos.
DATA_DIR=./data
ARCHIVE_DIR=./archives
SNAPSHOT_RETENTION_DAYS=30
# Frecuencia de respaldo en minutos. Un intervalo recomendado inicial: 30.
SYNC_INTERVAL_MINUTES=30

# Lista CORS opcional, separada por comas. Déjela vacía para servir solamente la misma aplicación.
ALLOWED_ORIGINS=
